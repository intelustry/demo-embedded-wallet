# 1Password secret-reference file (safe to commit — contains NO secret values).
# Resolve + inject at runtime with:  op run --env-file=op.env -- pnpm dev
# Each op:// reference points at a field in your 1Password vault.
# Convention used: vault "Development", item "Turnkey Demo Wallet".

# --- Public / non-sensitive config (plain values are fine here) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=https://api.turnkey.com
NEXT_PUBLIC_FACEBOOK_GRAPH_API_VERSION=21.0
NEXT_PUBLIC_FACEBOOK_AUTH_VERSION=11.0

# --- Identifiers (not secret, but environment-specific) ---
NEXT_PUBLIC_ORGANIZATION_ID=op://Development/Turnkey Demo Wallet/organization_id
NEXT_PUBLIC_RP_ID=op://Development/Turnkey Demo Wallet/rp_id
NEXT_PUBLIC_AUTH_PROXY_ID=op://Development/Turnkey Demo Wallet/auth_proxy_id
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=op://Development/Turnkey Demo Wallet/google_oauth_client_id
NEXT_PUBLIC_APPLE_OAUTH_CLIENT_ID=op://Development/Turnkey Demo Wallet/apple_oauth_client_id
NEXT_PUBLIC_FACEBOOK_CLIENT_ID=op://Development/Turnkey Demo Wallet/facebook_client_id

# --- Sensitive server-only secrets (NEVER store in plaintext) ---
ALCHEMY_API_KEY=op://Development/Turnkey Demo Wallet/alchemy_api_key
COINGECKO_API_KEY=op://Development/Turnkey Demo Wallet/coingecko_api_key

TURNKEY_API_PUBLIC_KEY=op://Development/Turnkey Demo Wallet/turnkey_api_public_key
TURNKEY_API_PRIVATE_KEY=op://Development/Turnkey Demo Wallet/turnkey_api_private_key

TURNKEY_WARCHEST_API_PUBLIC_KEY=op://Development/Turnkey Demo Wallet/warchest_api_public_key
TURNKEY_WARCHEST_API_PRIVATE_KEY=op://Development/Turnkey Demo Wallet/warchest_api_private_key
TURNKEY_WARCHEST_ORGANIZATION_ID=op://Development/Turnkey Demo Wallet/warchest_organization_id
WARCHEST_PRIVATE_KEY_ID=op://Development/Turnkey Demo Wallet/warchest_private_key_id

FACEBOOK_SECRET_SALT=op://Development/Turnkey Demo Wallet/facebook_secret_salt

CURSOR_API_KEY=op://Development/Turnkey Demo Wallet/cursor_api_key
